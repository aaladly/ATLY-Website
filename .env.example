# ATLY Belgian Chocolate — environment variable NAMES only.
# Never commit real values. Copy this file to .env.local and fill it in there.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=

# ---- Supabase (orders, customers, admin overrides) ----
#
# Both of these together are the switch: with both set, orders and admin
# settings go to Postgres; with either missing, they are held in memory and
# lost on restart. There is no third state and nothing else to toggle.
#
# Project Settings -> API in the Supabase dashboard. Run the SQL in
# supabase/migrations/ in order (0001, 0002, 0003) before the first order.
NEXT_PUBLIC_SUPABASE_URL=

# The anon key is not currently used: every table holding customer data has RLS
# on with no permissive policy, and all reads and writes go through the server.
# Left here because a future browser-side read of the public catalog would want
# it, and because leaving the name documented is better than someone reaching
# for the service role key instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY, AND IT BYPASSES ROW LEVEL SECURITY ENTIRELY.
# This key can read every order and every delivery address in the business.
# src/lib/supabase.ts carries `import "server-only"` so that importing it from
# a client component is a build error rather than a leak. Never rename this to
# anything starting NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----
#
# All three are needed for a working checkout. With none of them set the site
# validates an order completely and then declines it, which is deliberate: an
# unpaid order reaching the kitchen is worse than a checkout that refuses.
#
# Test keys come from the Stripe dashboard in test mode and need no business
# verification. They start sk_test_ / pk_test_ and cannot move real money.

# Mounts the card field in the browser. Publishable keys are meant to be
# public — that is their purpose — which is why this one is NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SERVER ONLY. Creates PaymentIntents, i.e. charges money.
STRIPE_SECRET_KEY=

# Signs the webhook at /api/stripe/webhook, which is the ONLY thing that marks
# an order paid. Without it that route refuses every event and a customer who
# has been charged leaves an order stuck in awaiting_payment.
#
# Locally this is whatever `stripe listen --forward-to
# localhost:3100/api/stripe/webhook` prints. In production it is the signing
# secret of the endpoint you add in the dashboard — they are different values.
STRIPE_WEBHOOK_SECRET=

# Restricts checkout to card, Apple Pay and Google Pay.
#
# NOT optional in practice. A Stripe account ships with a default
# configuration that has Klarna, Link, Amazon Pay, Cash App and Affirm
# switched on, and the Payment Element displays THAT — restricting the
# intent alone leaves a checkout offering methods that fail on confirm.
# Leave this blank and the account default comes back.
#
# Make one: Stripe dashboard -> Settings -> Payment methods -> a new
# configuration with card, Apple Pay and Google Pay only. The id is not a
# secret, which is why it is NEXT_PUBLIC: the browser needs the same value
# so the card field and the intent agree.
NEXT_PUBLIC_STRIPE_PAYMENT_METHOD_CONFIGURATION=

# ---- Resend (Step 7: order confirmation + new-order notification) ----
RESEND_API_KEY=
# Address that customer order confirmations are sent from.
ORDER_CONFIRMATION_FROM_EMAIL=
# Internal address that new-order alerts go to.
ORDER_NOTIFICATION_TO_EMAIL=

# ---- Analytics ----
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
#
# LEAVING THIS BLANK IS A REAL CHOICE, not an unfinished one. With no ID:
#   - no analytics loads, ever
#   - the cookie banner does not render, because there is nothing to consent to
#   - the privacy page says analytics is not running
# Set it and all three flip on together. The tag is injected only after a
# visitor accepts (src/lib/analytics.ts) -- there is no static script tag
# anywhere in this project, and there must not be one.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Admin (Step 9) ----
# Generate both with the project's own commands. Neither ever asks you to put
# a password in a file, and neither prints one.
#
#   npm run admin:password   -> ADMIN_PASSWORD_HASH (scrypt hash; no password stored)
#   npm run admin:secret     -> ADMIN_SESSION_SECRET (32 random bytes, signs the cookie)
#
# With either one missing, nobody can sign in to /admin — including anyone who
# should not. There is no default password.
#
# Note: this file is read with variable expansion, so a value containing a
# literal $ is rewritten on the way in and will silently stop working. Both
# commands above emit values that avoid $ entirely for exactly that reason.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
