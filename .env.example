# ATLY Belgian Chocolate — environment variable NAMES only.
# Never commit real values. Copy this file to .env.local and fill it in there.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=

# ---- Supabase (Step 3: catalog, orders, customers, delivery zones) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (Step 7: payment + NJ sales tax) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Resend (Step 7: order confirmation + new-order notification) ----
RESEND_API_KEY=
# Address that customer order confirmations are sent from.
ORDER_CONFIRMATION_FROM_EMAIL=
# Internal address that new-order alerts go to.
ORDER_NOTIFICATION_TO_EMAIL=

# ---- Admin (Step 9) ----
# Generate both with the project's own commands. Neither ever asks you to put
# a password in a file, and neither prints one.
#
#   npm run admin:password   -> ADMIN_PASSWORD_HASH (scrypt hash; no password stored)
#   npm run admin:secret     -> ADMIN_SESSION_SECRET (32 random bytes, signs the cookie)
#
# With either one missing, nobody can sign in to /admin — including anyone who
# should not. There is no default password.
#
# Note: this file is read with variable expansion, so a value containing a
# literal $ is rewritten on the way in and will silently stop working. Both
# commands above emit values that avoid $ entirely for exactly that reason.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
