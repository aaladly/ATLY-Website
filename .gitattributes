# Text files are stored with LF in the repository and checked out native.
# Keeps diffs clean across Windows development and Linux (Vercel) builds.
* text=auto eol=lf

# Binary assets — never line-ending normalize these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
